/****************************************************************************************/
/*
	函数: static void axififo_send(unsigned char mode, unsigned int data)
	作用: axififo 发送函数
	参数:
        mode：帧类型
        data:发送的数据
	返回值:
        无
*/
static void axififo_send(unsigned char mode, unsigned int data)
{
    int ret;
    unsigned int send_size;
    uartlist_send_info_t send_info;

    send_info.head = htons(0xec91);
    send_info.len = 4;
    send_info.mode = mode;
    send_info.data = data;
    send_info.sum = check_sum((unsigned char*)&send_info.data, sizeof(send_info.data));

    send_size = 0;
    while(1){
        ret = stream_fifo_write_data(&g_axififo_info->fifo_reg,(uint8_t *)(&send_info + send_size),sizeof(send_info) - send_size);
        if(ret == (sizeof(send_info) - send_size)){
            break;
        }
        send_size += ret;
        //usleep(1000);
        xt_nanosleep(0, 100);
    }

    return ;
}

/***************axififo_frame_request_type1***********************************************/
/*
	函数: axififo_frame_request_type1(unsigned char* frame_buff, unsigned int frame_size)
	作用: 帧类型1解析函数
	参数:
        frame_buff:帧类型1的数据buffer
        frame_size:帧类型1的数据长度
	返回值:
        正确返回0，失败返回其他
*/
static int axififo_frame_request_type1(unsigned char* frame_buff, unsigned int frame_size)
{

    char date[128];
    system_time_info_t *time_info;
    pcie_timestamp_t t0, t1;
    time_info = (system_time_info_t *)(frame_buff + 1);

    get_pcie_timestamp(&t0);
    /*设置年月日*/
    memset(date, 0x0, sizeof(date));
    sprintf(date, "date -s %d%.2d%.2d",(time_info->year),(time_info->mon),time_info->mday);
    system(date);

    /*设置时分秒*/
    memset(date, 0x0, sizeof(date));
    sprintf(date, "date -s %d:%d:%d",time_info->hour,time_info->min,time_info->sec);
    system(date);
    get_pcie_timestamp(&t1);

    SLOGI("[Debug],t0.h:0x%x, t0.l:0x%x, t1.h:0x%x t1.l:0x%x diff:%ld \n", t0.time_h, t0.time_l, t1.time_h, t1.time_l,pcie_diff_timestamp(&t1, &t0));

    return 0;
}

/****************************axififo_frame_request_type2******************************************/
/*
	函数: unsigned int axififo_frame_request_type2(unsigned char* frame_buff, unsigned int frame_size)
	作用: 帧类型2解析函数
	参数:
        frame_buff:帧类型1的数据buffer
        frame_size:帧类型1的数据长度
	返回值:
        正确返回0，失败返回其他
*/
static unsigned int axififo_frame_request_type2(unsigned char* frame_buff, unsigned int frame_size)
{
    unsigned int ret;
    unsigned char chn;
    fpga_chn_image_info_t* chn_image;
    data_stream_t *data_stream = data_stream_get();

    chn = frame_buff[1];
    chn_image = data_stream->chn_image[chn];
    memcpy(&chn_image->ratio_info, (frame_buff + 1), (frame_size - 1));

    /*如果本通道已经初始化了，则跳过*/
    if(chn_image->init_flag[DATA_INIT]){
        return 0;
    }

    chn_image->init_flag[DATA_INIT] = 0;

    chn_image->data_frame_max = 0;
    /*设置帧buffer的个数*/
    if((chn_image->ratio_info.src_width == VIDEO_FRAME_WIDTH_4k) && (chn_image->ratio_info.src_height == VIDEO_FRAME_HEIGHT_4k)){
        chn_image->data_frame_max = DATA_4K_STREAM_FRAME_MAX;
    } else {
        chn_image->data_frame_max = DATA_STREAM_FRAME_MAX;
    }

    ret = data_stream_low_chn_thread_init(chn_image->ratio_info.chn);
    if (ret != A818_SUCCESS) {
        SLOGI("data_stream_low_chn_thread_init error \n");
        return ret;
    }
    usleep(400*1000);

    /*初始化资源*/
    ret = data_stream_low_chn_data_init(chn_image->ratio_info.chn);
    if (ret != A818_SUCCESS) {
        SLOGI("chn data stream init error \n");
        goto err;
    }
#ifndef DEBUG_IMAGE
    fill_fpga_ratio_image_info(&chn_image->reg_val, &chn_image->ratio_info);
#else
    test_fill_fpga_ratio_image_info(&chn_image->reg_val, &chn_image->ratio_info);
#endif
    pcie_chn_image_reg_init(&chn_image->reg_val);

    g_axififo_info->rk_enable = 1;

    chn_image->init_flag[DATA_INIT] = 1;
    // if(data_stream->ratio == VIDEO_RATIO_3){
    //     chn_image->ratio_info.position = chn_image->ratio_info.position * 2 + 1;
    // } 
    data_stream->stitchbase_position |= 1 << chn_image->ratio_info.position;

    return A818_SUCCESS;
err:
    data_stream_low_chn_thread_destory(chn_image->ratio_info.chn);
    return ret;
}

/*********************************************************************/
/*****************************axififo_frame_request_type4****************************************/
/*
	函数: unsigned int request_type4_data_init(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4的数据初始化
	参数:
        chn_image:通道结构体
	返回值:
        正确返回0，失败返回其他
*/
unsigned int request_type4_data_init(fpga_chn_image_info_t* chn_image)
{
    unsigned int ret;

    if(chn_image->init_flag[DATA_INIT]){
        return 0;
    }
    chn_image->init_flag[DATA_INIT] = 0;

    /*判断是不是拼接通道*/
    if(chn_image->mpp_info.chn != GPU_STITCHBASE_CHN) {
        chn_image->data_frame_max = 0;
        if((chn_image->mpp_info.width == VIDEO_FRAME_WIDTH_4k) && (chn_image->mpp_info.height == VIDEO_FRAME_HEIGHT_4k)){
            chn_image->data_frame_max = DATA_4K_STREAM_FRAME_MAX;
        } else {
            chn_image->data_frame_max = DATA_STREAM_FRAME_MAX;
        }
    #ifndef DEBUG_IMAGE    
        fill_fpga_src_image_info(&chn_image->reg_val, &chn_image->mpp_info);
    #else
        test_fill_fpga_src_image_info(&chn_image->reg_val, &chn_image->mpp_info);
    #endif
        pcie_chn_image_reg_init(&chn_image->reg_val);

    } else {
        chn_image->init_flag[DATA_INIT] = 0;
        /*初始化拼接线程*/
        ret = data_stream_stitchbase_thread_init();
        if(ret != 0){
            SLOGI("[DEBUG] data_stream_stitchbase_thread_init ERROR \n");
            return ret;
        }
    }

    chn_image->init_flag[DATA_INIT] = 1;

    return 0;
}

/*
	函数: void request_type4_data_destory(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4的资源的释放
	参数:
        chn_image:通道结构体
	返回值:
        无
*/
void request_type4_data_destory(fpga_chn_image_info_t* chn_image)
{
    if(!chn_image->init_flag[DATA_INIT]){
        return ;
    }

    if(chn_image->mpp_info.chn != GPU_STITCHBASE_CHN) {
        pcie_close_chn_enabne(chn_image->mpp_info.chn);
    } else {
        data_stream_stitchbase_thread_destory();
    }

    chn_image->init_flag[DATA_INIT] = 0;
}

/*
	函数: int request_type4_osd_init(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4的字符叠加资源的初始化
	参数:
        chn_image:通道结构体
	返回值:
        正确返回0，失败返回其他
*/
static int request_type4_osd_init(fpga_chn_image_info_t* chn_image)
{
    
    int ret;
    data_stream_t *data_stream = data_stream_get();

    if(chn_image->init_flag[OSD_INIT]){
        return A818_FIFO_CMD_REINVENT;
    }

    chn_image->init_flag[OSD_INIT] = 0;

    ret = gpu_osd_chn_image_init(chn_image->mpp_info.chn, chn_image->mpp_info.width, chn_image->mpp_info.height);
    if (ret != 0) {
        SLOGI("gpu_osd_chn_image_init error \n");
        return ret;
    }

    chn_image->init_flag[OSD_INIT] = 1;

    ret = gui_osd_overlapped_chn_init(chn_image->mpp_info.chn);
    if(ret != 0){
        SLOGI("gui_osd_overlapped_chn_init error \n");
        goto err;
    }

    return 0;

err:
    gpu_osd_chn_image_destory(chn_image->mpp_info.chn);
    chn_image->init_flag[OSD_INIT] = 0;
    return ret;
}

/*
	函数: void request_type4_osd_destory(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4的字符叠加资源的释放
	参数:
        chn_image:通道结构体
	返回值:
        无
*/
static void request_type4_osd_destory(fpga_chn_image_info_t* chn_image)
{
    data_stream_t *data_stream = data_stream_get();
    if(!chn_image->init_flag[OSD_INIT]){
        return ;
    }
    gui_osd_overlapped_chn_destory(chn_image->mpp_info.chn);
    gpu_osd_chn_image_destory(chn_image->mpp_info.chn);
    chn_image->init_flag[OSD_INIT] = 0;
}

/*
	函数: static void mpp_encode_cmd_init(MpiEncAppArgs *encode_cmd, mpp_image_info_t *mpp_info)
	作用: 编码相关的初始化
	参数:
        encode_cmd:mpp结构体
        mpp_info：配置mpp相关资源的结构体
	返回值:
        无
*/
static void mpp_encode_cmd_init(MpiEncAppArgs *encode_cmd, mpp_image_info_t *mpp_info)
{
    encode_cmd->width = mpp_info->width; 
    encode_cmd->height = mpp_info->height;

    encode_cmd->format = MPP_FMT_YUV422SP;
    //encode_cmd->format = MPP_FMT_YUV420SP;
    if(mpp_info->mpp_type){
        encode_cmd->type = MPP_VIDEO_CodingHEVC; /**< H.265/HEVC */
    } else {
        encode_cmd->type = MPP_VIDEO_CodingAVC;  /**< H.264/AVC */
    }
    
    encode_cmd->fps_in_num = mpp_info->fps;
    encode_cmd->fps_out_num = mpp_info->fps;
    encode_cmd->bps_target = mpp_info->mpp_bps * 1024;
}

/*
	函数: static int request_type4_mpp_init(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4编码相关的初始化
	参数:
        chn_image:通道结构体
	返回值:
        正确返回0，失败返回其他
*/
static int request_type4_mpp_init(fpga_chn_image_info_t* chn_image)
{
    int ret;
    MpiEncAppArgs encode_cmd;

    if(chn_image->init_flag[MPP_INIT]){
        return 0;
    }
    chn_image->init_flag[MPP_INIT] = 0;
    /*mpp相关的资源初始化*/
    mpp_encode_cmd_init(&encode_cmd, &chn_image->mpp_info);
    ret = mpp_encode_chn_init(chn_image->mpp_info.mpp_chn, chn_image->mpp_info.chn, &encode_cmd);
    if (ret != 0) {
        SLOGI("encode frame chn init error \n");
        return ret;
    }
    chn_image->init_flag[MPP_INIT] = 1;

    return 0;
}

/*
	函数: void request_type4_mpp_destory(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4编码相关的释放
	参数:
        chn_image:通道结构体
	返回值:
        无
*/
static void request_type4_mpp_destory(fpga_chn_image_info_t* chn_image)
{
    if(!chn_image->init_flag[MPP_INIT]){
        return ;
    }
    mpp_encode_chn_destory(chn_image->mpp_info.mpp_chn);
    chn_image->init_flag[MPP_INIT] = 0;
}

/*
	函数: unsigned int request_type4_dp_init(fpga_chn_image_info_t* chn_image)
	作用: 帧类型4dp相关的资源初始化
	参数:
        chn_image:通道结构体
	返回值:
        正确返回0，失败返回其他
*/
static unsigned int request_type4_dp_init(fpga_chn_image_info_t* chn_image)
{
    int ret;
    data_stream_t *data_stream = data_stream_get();

    if(data_stream->dp_chn != 0){
        SLOGI("dp chn init error \n");
        return 0;
    }

    data_stream->dp_chn = 0;
    /*初始化DP资源*/
    ret = drm_dp_chn_image_init(chn_image->mpp_info.width, chn_image->mpp_info.height);
    if (ret != 0) {
        SLOGI("gpu_osd_chn_image_init error %d \n", ret);
        return ret;
    }

    data_stream->dp_chn = chn_image->mpp_info.chn;

    return 0;
}

/*
	函数: int axififo_frame_request_type4(unsigned char* frame_buff, unsigned int frame_size)
	作用: 帧类型4初始化
	参数:
        frame_buff:帧数据的buffer
        frame_size:帧数据的buffer数据
	返回值:
        正确返回0，失败返回其他
*/
static int axififo_frame_request_type4(unsigned char* frame_buff, unsigned int frame_size)
{
    int ret;
    int rc;
    unsigned char chn;
    fpga_chn_image_info_t* chn_image;
    unsigned char mpp_type, dp_type, pc_type;
    data_stream_t *data_stream = data_stream_get();
    if(!data_stream){
        printf("[Debug] %s data_stream error \n", __func__);
        return 1;
    }

    rc = 0;

    chn = frame_buff[1];
    chn_image = data_stream->chn_image[chn];
    if(!data_stream){
        printf("[Debug] %s data_stream error \n", __func__);
        return 1;
    }

    memcpy(&chn_image->mpp_info, (frame_buff + 1), (frame_size - 1));

    /*判断输出的类型*/
    switch(chn_image->mpp_info.out_type){
        case NULL_OUT_TYPE:
            mpp_type = 0;
            dp_type = 0;
            pc_type = 0;
        break;
        case MPP_OUT_TYPE:
            mpp_type = 1;
            dp_type = 0;
            pc_type = 0;
        break;
        case DP_OUT_TYPE:
            mpp_type = 0;
            dp_type = 1;
            pc_type = 0;
        break;

        case PC_OUT_TYPE:
            mpp_type = 0;
            dp_type = 0;
            pc_type = 1;
        break;

        case MPP_DP_OUT_TYPE:
            mpp_type = 1;
            dp_type = 1;
            pc_type = 0;
        break;
        case MPP_PC_OUT_TYPE:
            mpp_type = 1;
            dp_type = 0;
            pc_type = 1;
        break;
        case DP_PC_OUT_TYPE:
            mpp_type = 0;
            dp_type = 1;
            pc_type = 1;
        break; 
        case MPP_DP_PC_OUT_TYPE:
            mpp_type = 1;
            dp_type = 1;
            pc_type = 1;
        break; 
        default:
            mpp_type = 0;
            dp_type = 0;
            pc_type = 0;
            return 1;
    }

    SLOGI("[DEBUG] mpp_type:%d dp_type:%d pc_type%d chn:(%d-%d) \n", mpp_type, dp_type, pc_type, chn, chn_image->mpp_info.chn);
    /*是否是编码输出或者dp输出*/
    if(mpp_type || dp_type){
        ret =request_type4_data_init(chn_image);
        if(ret != 0){
            SLOGI("request_type4_data_init ERROR \n");
            return ret;
        }

        usleep(10*1000);

        ret = request_type4_osd_init(chn_image);
        if(ret != 0){
            SLOGI("request_type4_osd_init ERROR \n");
            goto err_1;
        }

        usleep(10*1000);
        /*如果编码输出，初始化编码资源*/
        if(mpp_type){
            ret = request_type4_mpp_init(chn_image);
            if(ret != 0){
                SLOGI("request_type4_mpp_init ERROR \n");
                goto err_2;
            }
            usleep(10*1000);

        }

        g_axififo_info->rk_enable = 1;

        /*如果是dp输出，初始化dp资源*/
        if(dp_type){
            ret = request_type4_dp_init(chn_image);
            if(ret != 0){
                SLOGI("request_type4_mpp_init ERROR \n");
                //goto err_3;
                rc = ret;
            }
            usleep(10*1000);
        }
    }

    /*判断是不是原图输出，原图输出直接配置相关的寄存器即可*/
    if(pc_type){
        if(chn_image->mpp_info.chn != GPU_STITCHBASE_CHN){
        #ifndef DEBUG_IMAGE
            fill_fpga_src_image_info(&chn_image->reg_val, &chn_image->mpp_info);
        #else
            test_fill_fpga_src_image_info(&chn_image->reg_val, &chn_image->mpp_info);
        #endif
            pcie_pc_chn_image_reg_init(&chn_image->reg_val);
        }
        g_axififo_info->pc_enable = 1;
    }

    return rc;

err_3:
   if(mpp_type){
        request_type4_mpp_destory(chn_image);
   }
err_2:
    request_type4_osd_destory(chn_image);
err_1:
    request_type4_data_destory(chn_image);

    return ret;

}

/*******************************************************************************/
/******************axififo_frame_type6_selftest********************************/
static int axififo_frame_type6_selftest(unsigned char mode)
{
#if 0
    int ret;
    unsigned int send_size;
    uartlist_type6_info_t send_info;

    send_info.head = htons(0xec91);
    send_info.len = sizeof(send_info.selftest) + 1;
    send_info.mode = mode;

    pcie_get_selftest_val(&send_info.selftest);

    send_info.sum = check_sum((unsigned char*)&send_info.mode, send_info.len);

    send_size = 0;
    while(1){
