/*
	函数: static void test_fill_fpga_ratio_image_info(fpga_reg_val_info_t* reg_val, ratio_image_info_t* ratio_info)
	作用: 测试模式拼接小图图像寄存器的填充
	参数:
        reg_val：需要设置的寄存器的值
        ratio_info:收到的寄存器的值
	返回值:
        无
*/
static void test_fill_fpga_ratio_image_info(fpga_reg_val_info_t* reg_val, ratio_image_info_t* ratio_info)
{

    reg_val->chn = ratio_info->chn;
    reg_val->chn_type = INTERNAL_SOURCE_MODE;
    reg_val->extraction = ratio_info->extraction;
    reg_val->fill_column = ratio_info->fill_column;
    reg_val->fill_row = ratio_info->fill_row;
    reg_val->ratio = ratio_info->mode;
    reg_val->src_height = ratio_info->src_height;
    reg_val->src_width = ratio_info->src_width;
    reg_val->zoom_height = ratio_info->height;
    reg_val->zoom_width = ratio_info->width;
    reg_val->fps = ratio_info->fps;
}

/*
	函数: static test_fill_fpga_src_image_info(fpga_reg_val_info_t* reg_val, mpp_image_info_t* mpp_info)
	作用: 测试模式编码图像寄存器的填充
	参数:
        reg_val：需要设置的寄存器的值
        ratio_info:收到的寄存器的值
	返回值:
        无
*/
static void test_fill_fpga_src_image_info(fpga_reg_val_info_t* reg_val, mpp_image_info_t* mpp_info)
{
    reg_val->chn = mpp_info->chn;
    reg_val->chn_type = INTERNAL_SOURCE_MODE;
    reg_val->extraction = mpp_info->extraction;
    reg_val->fill_column = 0;
    reg_val->fill_row = 0;
    reg_val->ratio = 1;
    reg_val->src_height = mpp_info->height;
    reg_val->src_width = mpp_info->width;
    reg_val->zoom_height = mpp_info->height;
    reg_val->zoom_width = mpp_info->width;
    reg_val->fps = mpp_info->fps;

}

